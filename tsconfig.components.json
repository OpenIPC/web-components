{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
		"jsx": "react-jsx",
		"jsxImportSource": "preact",
		"paths": {
			"react": ["../../node_modules/preact/compat/"],
			"react-dom": ["../../node_modules/preact/compat/"]
		}
  },
  "include": [
    "./**/*.ts", 
    "./**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "./**/*.stories.tsx",
    "./**/*.test.ts",
    "./**/*.spec.ts"
  ]
}
